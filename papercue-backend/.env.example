# PaperCue local configuration. Copy to `.env` and adjust.
# Everything runs on this machine. No remote AI, embedding, analytics, or telemetry services are used.

# --- Server (loopback only by default) ---
PAPERCUE_HOST=127.0.0.1
PAPERCUE_PORT=8000
# Refuses to start on a non-loopback host unless this is explicitly true. Do not enable with participant data.
PAPERCUE_ALLOW_NON_LOCAL_BIND=false

# --- Storage ---
DATABASE_PATH=./data/papercue.db
# Local text/Markdown papers may only be imported from inside this directory.
PAPERS_DIR=./data/papers
EXPORTS_DIR=./data/exports
# Sessions older than this are listed as expired and removed by the purge endpoint/script.
RETENTION_DAYS=7
PURGE_EXPIRED_ON_STARTUP=false

# --- Local LLM ---
# ollama | mock   (mock = deterministic rules; NOT genuine LLM output)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.1
# Refuses non-loopback Ollama URLs unless explicitly true.
OLLAMA_ALLOW_REMOTE=false
LLM_MAX_RETRIES=1

# --- Local embeddings ---
# sentence_transformers | hashing   (hashing = deterministic mock embedder for tests/demos)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# The embedding model is loaded from the local cache only. Run scripts/download_embedding_model.py once,
# or set this to true to allow a one-time model-weight download from the Hugging Face Hub.
EMBEDDING_ALLOW_DOWNLOAD=false

# --- Reasoning parameters ---
RECENT_TURN_WINDOW=6
PROFILE_CONFIDENCE_CAP=0.65
PROFILE_DECAY_PER_TURN=0.97
MIN_CUE_CONFIDENCE=0.45
AUTO_CANDIDATE_THRESHOLD=0.6
CUE_MAX_WORDS=12
RETRIEVAL_TOP_K=4
# rules | llm   (llm = local model proposes belief updates; deterministic policy still applies them)
AUDIENCE_UPDATE_STRATEGY=llm

# --- Debugging ---
# Stores full LLM prompts (which contain conversation text) in the database.
# NEVER enable with real participant data.
DEBUG_STORE_PROMPTS=false
LOG_LEVEL=INFO
